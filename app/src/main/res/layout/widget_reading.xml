<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景：程序动态设置取色后的 Bitmap -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- 半透明暗色遮罩，保证白色文字可读 -->
    <View
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- 内容区：居中 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <!-- 封面缩略图 -->
        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="60dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_cover_placeholder" />

        <TextView
            android:id="@+id/widget_book_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="书籍名称"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0%"
            android:textColor="#BFFFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_record_button"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_button_bg"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:text="记录进度"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 底部翻页导航 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_prev_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="◀"
            android:textColor="#BFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_page_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:text="1/5"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_next_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#BFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
